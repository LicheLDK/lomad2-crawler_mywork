NODE_ENV=development
PORT=3100
APP_NAME=search-crawler-server

# API Security
API_KEY=change-me-api-key
JWT_SECRET=change-me-jwt-secret
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=crawler
DB_PASSWORD=crawler
DB_NAME=search_crawler

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CRAWL_QUEUE_NAME=crawl-queue
CRAWL_CONCURRENCY=5
CRAWL_ATTEMPTS=3
CRAWL_BACKOFF_MS=5000

# Elasticsearch
ELASTIC_NODE=http://127.0.0.1:9200
ELASTIC_INDEX=crawler_results
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# Playwright / Crawler
PLAYWRIGHT_HEADLESS=true
ENABLE_WORKER=true
CRAWLER_TIMEOUT_MS=30000
CRAWLER_NAVIGATION_TIMEOUT_MS=45000
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
CRAWLER_REQUEST_DELAY_MS=1500
CRAWLER_PROXY_URL=

# Cache
SEARCH_CACHE_TTL_SECONDS=3600
