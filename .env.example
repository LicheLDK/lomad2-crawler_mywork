NODE_ENV=development
PORT=3100
APP_NAME=search-crawler-server

# 환경변수 상세 설명: docs/환경변수.md
# 이 파일은 복사 템플릿입니다 → cp .env.example .env

# Logging (파일: logs/{api|worker|web}/ — pretty JSON, pino-roll)
# LOG_APP=api
# LOG_FILE=true
# LOG_LEVEL=debug
# LOG_PRETTY=true
# LOG_COMPACT=false
# LOG_FREQUENCY=daily
# LOG_SIZE=20m
# LOG_RETENTION=14
# LOG_DIR=
# TYPEORM_LOGGING=true
# TYPEORM_SLOW_MS=1000

# API Security
# 로컬(development): 예제값 허용
# 운영(NODE_ENV=production): 예제값/짧은 값이면 기동 실패 (min 24자, API_KEY ≠ JWT_SECRET)
API_KEY=change-me-api-key
JWT_SECRET=change-me-jwt-secret
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=crawler
DB_PASSWORD=crawler
DB_NAME=search_crawler

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CRAWL_QUEUE_NAME=crawl-queue
CRAWL_CONCURRENCY=5
CRAWL_ATTEMPTS=3
CRAWL_BACKOFF_MS=5000
# Bull failed/DLQ 보존 (B4: 14일 또는 최근 500건)
QUEUE_FAILED_RETENTION_DAYS=14
QUEUE_FAILED_MAX_COUNT=500

# 메트릭 테이블 retention (B4/B-8) — npm run retention:cleanup 으로 일괄 삭제
# METRICS_RETENTION_ENABLED=false 로 정리 잡 비활성화
METRICS_RETENTION_ENABLED=true
METRICS_RETENTION_CRAWL_ATTEMPTS_DAYS=90
METRICS_RETENTION_AI_USAGE_DAYS=180
METRICS_RETENTION_BATCH_SIZE=1000

# Elasticsearch
ELASTIC_NODE=http://127.0.0.1:9200
ELASTIC_INDEX=crawler_results
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# Playwright / Crawler
PLAYWRIGHT_HEADLESS=true
ENABLE_WORKER=true
CRAWLER_TIMEOUT_MS=30000
CRAWLER_NAVIGATION_TIMEOUT_MS=45000
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
CRAWLER_REQUEST_DELAY_MS=1500
CRAWLER_PROXY_URL=

# Cache
SEARCH_CACHE_TTL_SECONDS=3600

# Search Job 타임아웃 (A3 이중 상한)
# 키워드별 개별 상한 (기본 3분 = 2초 × 90회)
SEARCH_JOB_KEYWORD_TIMEOUT_MS=180000
# Job 전체 상한 (기본 10분)
SEARCH_JOB_TOTAL_TIMEOUT_MS=600000

# Image download (SSRF / size limits)
IMAGE_MAX_BYTES=5242880
IMAGE_DOWNLOAD_TIMEOUT_MS=15000
IMAGE_MAX_REDIRECTS=3
# 비우면 공인 IP 호스트 전부 허용. 예: media.bunjang.co.kr,*.daangn.com
IMAGE_DOWNLOAD_ALLOW_HOSTS=
# 미설정 시 개발=true / 운영=false
IMAGE_ALLOW_HTTP=

# Laravel 쇼핑몰(렌탈) 외부 API — 주문/상품은 DB 직접 조회 금지, Client Layer 만 사용
RENTAL_API_BASE_URL=
RENTAL_API_KEY=
RENTAL_API_TIMEOUT_MS=10000
RENTAL_ORDER_PATH=/api/internal/orders/:orderId
RENTAL_PRODUCT_PATH=/api/internal/products/:productId
# 검색 완료 Callback (BackOffice Badge용)
RENTAL_SEARCH_CALLBACK_PATH=/api/internal/search-jobs/callback
RENTAL_SEARCH_CALLBACK_ENABLED=true

# Investigation 자동 생성 (AI Score 0~100, 기본 90)
INVESTIGATION_AI_SCORE_THRESHOLD=90
# 워치리스트(관찰) 하한 — threshold 미만 · 이 값 이상이면 Investigation + watchlisted
INVESTIGATION_WATCHLIST_MIN_SCORE=70
INVESTIGATION_AUTO_CREATE=true
# BackOffice 주문 상세 링크 ({orderNo} 치환)
BACKOFFICE_ORDER_URL_TEMPLATE=http://127.0.0.1/getOrderInfo?order_id={orderNo}

# AI Engine
# OPENAI_API_KEY 가 있으면 Keyword Generator 기본 활성 (AI_ENABLED=false 로 끌 수 있음)
AI_ENABLED=
AI_PROVIDER=openai
AI_TIMEOUT_MS=60000
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Vision Provider (미설정 시 AI_PROVIDER 와 동일)
AI_VISION_PROVIDER=
# Cost Management — 재시도 / 단가 오버라이드
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=500
# 예: {"gpt-4.1-mini":{"inputPer1M":0.4,"outputPer1M":1.6}}
AI_COST_PRICES_JSON=
# AI Rules (JSON 배열). 비우면 default seed:
#   AI Score >= INVESTIGATION_AI_SCORE_THRESHOLD → create_investigation
#   AI Score < 50 → exclude
#   priceDiffPercent >= 70 → warning
# AI_RULES_JSON=[{"code":"auto_create_high_score","name":"고점수 자동생성","field":"aiScore","operator":"gte","value":90,"action":"create_investigation","priority":100,"enabled":true}]
AI_RULES_JSON=
# Matching 전 OCR 분석 결과를 prompt에 포함 (true 시 analyzeOcr → matching prompt 반영)
AI_OCR_BEFORE_MATCH=false
# Matching 후 Vision 이미지 비교로 image 점수 보정 (기본 true, OpenAI Vision 실구현)
AI_VISION_BEFORE_MATCH=true
# Vision 직전 로컬 게이트 (기본 true) — Color → pHash → LooksSame → OpenCV
AI_LOCAL_IMAGE_GATE=true
# 색 히스토그램 미만이면 Vision 스킵 (확연히 다른 색)
AI_LOCAL_COLOR_REJECT_THRESHOLD=35
# pHash 미만이면 Vision 스킵 / 이상이면 거의 동일로 Vision 스킵(고점수)
AI_LOCAL_PHASH_REJECT_THRESHOLD=30
AI_LOCAL_PHASH_PASS_THRESHOLD=90
# SSIM — LooksSame 보완 (구조 유사 ≥75 Vision 후보 / ≥92 near-dup Vision 스킵)
AI_LOCAL_SSIM_THRESHOLD=75
AI_LOCAL_SSIM_PASS_THRESHOLD=92
AI_LOCAL_LOOKS_SAME_THRESHOLD=70
AI_LOCAL_OPENCV_THRESHOLD=60
AI_LOCAL_LOOKS_SAME_STRICT=false
AI_LOCAL_LOOKS_SAME_TOLERANCE=2.5
AI_LOCAL_LOOKS_SAME_IGNORE_ANTIALIASING=true
AI_LOCAL_OPENCV_ORB_NFEATURES=500
AI_LOCAL_OPENCV_ORB_MATCH_RATIO=0.75
AI_LOCAL_PREPROCESS_MAX_WIDTH=512
AI_LOCAL_PREPROCESS_MAX_HEIGHT=512
AI_LOCAL_PREPROCESS_BACKGROUND=ffffff
AI_LOCAL_PREPROCESS_NORMALIZE=true
# Matching LLM 배치 (1차 상위 N / 2차 추가 K)
AI_MATCH_BATCH_LIMIT=25
AI_MATCH_SECOND_PASS_LIMIT=10
AI_MATCH_SECOND_PASS_MIN_TITLE=0.2
