{
  "name": "search-crawler-server",
  "version": "1.0.0",
  "description": "중고거래 사이트 검색 크롤러 서버 (NestJS + Playwright + BullMQ)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "cross-env ENABLE_WORKER=false nest start --watch --exec \"node -r tsconfig-paths/register\"",
    "start:dev:api": "cross-env ENABLE_WORKER=false nest start --watch --exec \"node -r tsconfig-paths/register\"",
    "start:prod": "node -r ./dist/register-paths.js dist/main.js",
    "start:worker": "node -r ./dist/register-paths.js dist/worker.js",
    "start:worker:dev": "cross-env ENABLE_WORKER=true ts-node -r tsconfig-paths/register src/worker.ts",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 8",
    "test": "jest",
    "test:migration": "powershell -ExecutionPolicy Bypass -File scripts/test-migration-empty-volume.ps1",
    "test:migration:sh": "bash scripts/test-migration-empty-volume.sh",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:run:prod": "node -r ./dist/register-paths.js ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:show": "npm run typeorm -- migration:show -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:baseline:mark": "ts-node -r tsconfig-paths/register src/database/scripts/mark-baseline-migrated.ts",
    "postinstall": "playwright install chromium || true",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-source.ps1",
    "reset:dev-data": "powershell -ExecutionPolicy Bypass -File scripts/reset-dev-data.ps1",
    "infra:up": "docker compose up -d postgres redis elastic",
    "infra:up:light": "docker compose up -d postgres redis",
    "infra:down": "docker compose stop postgres redis elastic",
    "web:lint": "npm --prefix web run lint",
    "web:lint:ci": "npm --prefix web run lint -- --max-warnings 31",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:build:check": "npm --prefix web install && npm --prefix web run build",
    "build:all": "npm run build && npm run web:build",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "dev:all": "concurrently -k -n api,worker,web -c teal,magenta,cyan \"npm run start:dev:api\" \"npm run start:worker:dev\" \"npm run web:dev\"",
    "dev:light:apps": "concurrently -k -n api,web -c teal,cyan \"npm run start:dev:api\" \"npm run web:dev\"",
    "dev": "npm run infra:up && npm run dev:all",
    "dev:light": "npm run infra:up:light && npm run dev:light:apps",
    "dev:ps": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.17.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.28",
    "bullmq": "^5.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.5.0",
    "nestjs-pino": "^4.3.0",
    "pg": "^8.13.3",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.50.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "serve": "^14.2.6",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.21",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "forceExit": true
  }
}
