# Ubuntu/Debian logrotate — API/Worker(pino-roll) 보조 + Web/PM2 로그
# 설치:
#   sudo cp deploy/logrotate/lomad-crawler /etc/logrotate.d/lomad-crawler
#   # 아래 경로를 실제 배포 경로에 맞게 수정
#   sudo logrotate -d /etc/logrotate.d/lomad-crawler
#
# 앱 쪽(pino-roll)이 일/크기 로테이션을 이미 수행하므로,
# 여기서는 copytruncate 로 활성 파일·PM2 캡처 파일만 안전하게 자른다.

/opt/lomad/lomad2-crawler_mywork/logs/api/*.log
/opt/lomad/lomad2-crawler_mywork/logs/worker/*.log
/opt/lomad/lomad2-crawler_mywork/logs/web/*.log
{
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    dateformat -%Y%m%d
    maxsize 50M
}
